Thumbs.db
desktop.ini

# ---- generated / throwaway ----
# dataset.py is GENERATED by dataset_merge.py but IS committed: the experiment scripts
# import it. Its automatic backup is not.
dataset.py.bak
*.bak

# Dry-run logs are wiring checks with meaningless numbers (MESE_DRY=1), so they must never
# be mistaken for results. The real evidence logs (results/step5.txt, results/step6.txt,
# results/step7.txt and the *_alt.txt downloads) ARE committed and are cited in results.md.
results/*_dry.txt

# Colab scratch
sample_data/

# ---- scratch files ----
# Leading-underscore files are throwaway (smoke tests, temp logs, commit messages).
# Real tooling is NEVER underscore-prefixed; the five CPU self-tests in tests/ and
# check_length_control.py are named as such deliberately.
_*.py
_*.txt
_*.csv